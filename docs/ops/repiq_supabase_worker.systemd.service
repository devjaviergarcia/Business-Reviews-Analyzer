[Unit]
Description=Repiq Supabase Queue Worker
After=network.target

[Service]
Type=simple
User=javier
WorkingDirectory=/home/javier/Documentos/proyectos/aprender/review-llm
EnvironmentFile=/home/javier/Documentos/proyectos/aprender/review-llm/.env
ExecStart=/home/javier/Documentos/proyectos/aprender/review-llm/.venv-uv/bin/python scripts/run_supabase_queue_worker.py
